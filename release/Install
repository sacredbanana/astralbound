; Standard Commodore Installer language; preserve any existing commander save.
(set @app-name "Astralbound")
(set install-source (pathonly @icon))
(set @default-dest "SYS:Games/Astralbound")
(welcome "Install the original Astralbound Amiga game.")
(set destination (askdir
    (prompt "Choose the Astralbound destination drawer.")
    (help "Copies the game and guide. Existing astralbound.sav is preserved.")
    (default @default-dest) (newpath)))
(makedir destination)
(copyfiles
    (source install-source)
    (dest destination)
    (choices "Astralbound.000" "Astralbound.020" "Astralbound.030" "Astralbound.020fpu" "Astralbound.040" "Astralbound.060"
             "Astralbound.000.info" "Astralbound.020.info" "Astralbound.030.info" "Astralbound.020fpu.info"
             "Astralbound.040.info" "Astralbound.060.info"
             "Play-AGA" "Play-AGA.info" "Play-RTG" "Play-RTG.info"
             "Play-RTG16" "Play-RTG16.info" "Play-ECS-Lowres" "Play-ECS-Lowres.info"
             "Astralbound.guide" "Astralbound.guide.info" "README.md" "LICENSE" "THIRD_PARTY.txt")
    (prompt "Install Astralbound game files?")
    (help "Use Astralbound.000 on a 68000. Astralbound.020/.030 need no FPU. Astralbound.020fpu needs a 68020/030 with a 68881/68882; Astralbound.040 and Astralbound.060 need a full 68040/68060 with its FPU. Use Astralbound.020 on an LC/EC040 or LC/EC060.")
    (confirm))
(makedir (tackon destination "music"))
(makedir (tackon destination "music/battle"))
(makedir (tackon destination "music/planetary-flight"))
(makedir (tackon destination "music/space-flight"))
(makedir (tackon destination "music/docked"))
(makedir (tackon destination "music/game-over"))
(makedir (tackon destination "music/intro"))
(copyfiles
    (source (tackon install-source "music"))
    (dest (tackon destination "music"))
    (all)
    (optional nofail))
(copyfiles
    (source (tackon (pathonly install-source) "Astralbound.info"))
    (dest (pathonly destination))
    (newname (cat (fileonly destination) ".info"))
    (optional nofail))
(message "Astralbound installed. Open the drawer, choose a CPU icon or Play-AGA/Play-RTG. Escape exits.")
