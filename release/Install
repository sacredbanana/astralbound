; Standard Commodore Installer language; preserve any existing commander save.
(set @app-name "Space")
(set install-source (pathonly @icon))
(set @default-dest "SYS:Games/Space")
(welcome "Install the original Space Amiga game.")
(set destination (askdir
    (prompt "Choose the Space destination drawer.")
    (help "Copies the game and guide. Existing space.sav is preserved.")
    (default @default-dest) (newpath)))
(makedir destination)
(copyfiles
    (source install-source)
    (dest destination)
    (choices "Space.000" "Space.020" "Space.030" "Space.040" "Space.060"
             "Space.000.info" "Space.020.info" "Space.030.info" "Space.040.info" "Space.060.info"
             "Play-AGA" "Play-AGA.info" "Play-RTG" "Play-RTG.info"
             "Play-RTG16" "Play-RTG16.info" "Play-ECS-Lowres" "Play-ECS-Lowres.info"
             "Space.guide" "Space.guide.info" "README.md" "LICENSE" "THIRD_PARTY.txt")
    (prompt "Install Space game files?")
    (help "Use Space.000 on a 68000. Other CPU builds require the named CPU or newer.")
    (confirm))
(makedir (tackon destination "music"))
(makedir (tackon destination "music/battle"))
(makedir (tackon destination "music/planetary-flight"))
(makedir (tackon destination "music/space-flight"))
(makedir (tackon destination "music/docked"))
(makedir (tackon destination "music/game-over"))
(copyfiles
    (source (tackon install-source "music"))
    (dest (tackon destination "music"))
    (all)
    (optional nofail))
(copyfiles
    (source (tackon (pathonly install-source) "Space.info"))
    (dest (pathonly destination))
    (newname (cat (fileonly destination) ".info"))
    (optional nofail))
(message "Space installed. Open the drawer, choose a CPU icon or Play-AGA/Play-RTG. Escape exits.")
